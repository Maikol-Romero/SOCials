IDENTITY_PUB_PATH = "/var/lib/socialwarden/identity.pub"


def cmd_identity(_args):
    """Show this machine's ed25519 public identity + fingerprint.

    The pubkey is used by the manager to authenticate this machine when it
    requests Shamir shares from peers. Never prints the private key.
    """
    import hashlib
    p = Path(IDENTITY_PUB_PATH)
    if not p.exists():
        warn(f"No identity key at {IDENTITY_PUB_PATH}")
        warn("The agent generates it on startup. Restart service or wait one cycle.")
        warn("  sudo systemctl restart socialwarden-agent")
        sys.exit(1)
    try:
        pub_hex = p.read_text().strip()
    except PermissionError:
        err("Cannot read identity.pub (unexpected — file should be 0644)")
        sys.exit(2)
    try:
        pub_raw = bytes.fromhex(pub_hex)
    except ValueError:
        err(f"identity.pub contents malformed: {pub_hex[:60]}")
        sys.exit(3)

    fp = hashlib.sha256(pub_raw).hexdigest()[:16]
    print(f"{BOLD}Machine identity (ed25519){NC}")
    print(f"  Public key:  {pub_hex}")
    print(f"  Fingerprint: sha256:{fp}")
    print()
    print("To register on the manager host:")
    print(f"  {BOLD}sudo socialwarden-manager register-identity $(hostname -s){NC}")


# ---------------------------------------------------------------------------
# peer-test — verify share-release endpoint connectivity + auth with a peer
# ---------------------------------------------------------------------------
IDENTITY_PRIV_PATH = "/var/lib/socialwarden/identity.key"
SHARE_RELEASE_PORT = 14841


def cmd_peer_test(args):
    """Test share-release connectivity against <peer>.

    Asks the peer for THIS machine's share. If share is not stored on peer,
    expect HTTP 404 no_share — but auth (signature) succeeds so we know the
    pubkey distribution + ed25519 flow works. A full happy-path requires the
    enrollment flow (Task #36) to actually store shares.
    """
    import urllib.request, urllib.error, socket, hashlib as _h
    try:
        from cryptography.hazmat.primitives.asymmetric import ed25519
        from cryptography.hazmat.primitives import serialization
    except ImportError:
        err("cryptography library missing; peer-test unavailable")
        sys.exit(1)

    peer_ip = args.peer
    if not peer_ip:
        err("Usage: socialwarden-agent peer-test <peer-ip>")
        sys.exit(2)

    # Load our private key
    if not os.path.exists(IDENTITY_PRIV_PATH):
        err(f"No identity key at {IDENTITY_PRIV_PATH}")
        err("The agent generates it at startup. Restart service first.")
        sys.exit(1)
    try:
        priv_bytes = open(IDENTITY_PRIV_PATH, "rb").read()
    except PermissionError:
        err(f"Cannot read {IDENTITY_PRIV_PATH} — run with sudo")
        sys.exit(2)
    priv_key = serialization.load_pem_private_key(priv_bytes, password=None)

    # We sign as "ourself" — requester = our machine name.
    cfg = load_config()
    if not cfg:
        err("Cannot determine machine name — config missing")
        sys.exit(1)
    requester = cfg.get("machine", {}).get("name")
    if not requester:
        err("config.machine.name missing")
        sys.exit(1)

    ts = int(time.time())
    nonce = os.urandom(16).hex()
    canonical = f"v1|{requester}|{nonce}|{ts}".encode()
    sig_hex = priv_key.sign(canonical).hex()
    body = {
        "v": 1, "requester": requester, "nonce": nonce,
        "timestamp": ts, "signature": sig_hex,
    }

    # Health check first
    url_base = f"http://{peer_ip}:{SHARE_RELEASE_PORT}"
    try:
        r = urllib.request.urlopen(url_base + "/health", timeout=3)
        d = json.loads(r.read().decode())
        info(f"Peer /health OK: machine={d.get('machine')} v={d.get('v')}")
    except urllib.error.URLError as e:
        err(f"Cannot reach {url_base}/health: {e.reason}")
        sys.exit(3)
    except (socket.timeout, json.JSONDecodeError) as e:
        err(f"Health check error: {e}")
        sys.exit(3)

    # Share-release request
    import urllib.request as ur
    req = ur.Request(
        url_base + "/v1/shamir/release-share",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        resp = ur.urlopen(req, timeout=5).read().decode()
        d = json.loads(resp)
        info(f"share-release response: {d}")
        print(f"{BOLD}Interpretation:{NC}")
        if d.get("ok"):
            print(f"  {GREEN}✓ Peer has your share and released it{NC}")
        else:
            print(f"  error={d.get('error')}")
    except urllib.error.HTTPError as e:
        resp = e.read().decode()
        try:
            d = json.loads(resp)
        except json.JSONDecodeError:
            d = {"error": resp[:80]}
        print(f"  HTTP {e.code}: {d}")
        # Interpret the result
        if d.get("error") == "no_share":
            info("Auth succeeded; peer just doesn't have your share (expected pre-enrollment).")
        elif d.get("error") == "no_pubkey":
            warn("Peer doesn't have your pubkey registered.")
            warn("Run on manager: sudo socialwarden-manager distribute-pubkeys")
        elif d.get("error") == "bad_signature":
            err("Signature verification FAILED — pubkey on peer may be stale.")


