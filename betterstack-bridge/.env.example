# Better Stack API token (Settings → API tokens, "Status pages" scope)
BETTERSTACK_TOKEN=

# Numeric ID of your BetterStack status page (URL: /status-pages/<ID>)
BETTERSTACK_STATUS_PAGE_ID=

# Resource IDs from your status page (Status pages → Resources → click each, copy ID).
# One env var per service key defined in services.json — naming convention:
#   BS_RESOURCE_<SERVICE_KEY_UPPERCASE>=<resource_id>
#
# The shipped services.example.json defines: api, web, worker, database, queue.
# Edit services.json to add/remove keys, then add matching env vars below.
BS_RESOURCE_API=
BS_RESOURCE_WEB=
BS_RESOURCE_WORKER=
BS_RESOURCE_DATABASE=
BS_RESOURCE_QUEUE=

# Inbound shared secret. The /betterstack endpoint rejects POSTs without this
# token in the X-Bridge-Token header (or ?token= query string). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BS_INBOUND_TOKEN=
