# doctor — sanity checks
# ---------------------------------------------------------------------------
def cmd_doctor(_args):
    print(f"{BOLD}=== SocialWarden Doctor ==={NC}\n")
    problems = 0

    # Config
    cfg = load_config()
    if not cfg:
        err(f"Config missing or invalid at {CONFIG_PATH}")
        problems += 1
    else:
        info(f"Config OK ({CONFIG_PATH})")
        # Server URL
        url = cfg.get("server", {}).get("url")
        if not url:
            err("config.server.url missing")
            problems += 1
        # Machine name
        name = cfg.get("machine", {}).get("name")
        if not name:
            err("config.machine.name missing")
            problems += 1
        # Collections
        colls = cfg.get("sync", {}).get("collections", [])
        if not colls:
            warn("No collections configured — agent will run but sync nothing")
        else:
            info(f"{len(colls)} collection(s) configured")

    # Master key
    key_path = "/run/socialwarden/master.key"
    if cfg:
        key_path = cfg.get("auth", {}).get("master_key_path", key_path)
    try:
        st = os.stat(key_path)
        if st.st_mode & 0o077:
            err(f"Master key permissions too open: {oct(st.st_mode & 0o777)}; should be 0600")
            problems += 1
        else:
            info(f"Master key OK ({key_path}, mode {oct(st.st_mode & 0o777)})")
    except FileNotFoundError:
        warn(f"Master key missing at {key_path} — run `sudo bw unlock` once")
    except PermissionError:
        warn(f"Cannot stat master key at {key_path} (run with sudo to verify)")

    # bw CLI
    try:
        r = subprocess.run(["bw", "--version"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            info(f"bw CLI: v{r.stdout.strip()}")
        else:
            err("bw CLI failed to report version")
            problems += 1
    except (FileNotFoundError, subprocess.TimeoutExpired):
        err("bw CLI not found in PATH")
        problems += 1

    # Secrets dir
    sd = Path(SECRETS_DIR)
    if not sd.is_dir():
        warn(f"{SECRETS_DIR} does not exist yet")
    else:
        try:
            envs = list(sd.glob("*.env"))
            info(f"{SECRETS_DIR}: {len(envs)} env file(s)")
        except PermissionError:
            warn(f"Cannot list {SECRETS_DIR} (run with sudo for full view)")

    # Heartbeat
    age = heartbeat_age()
    if age is None:
        warn("No heartbeat yet — is the agent running?")
    elif age > 180:
        err(f"Heartbeat stale ({age:.0f}s ago)")
        problems += 1
    else:
        info(f"Heartbeat fresh ({age:.0f}s ago)")

    print()
    if problems:
        err(f"{problems} problem(s) found")
        sys.exit(1)
    else:
        info("All checks passed")


# ---------------------------------------------------------------------------
# discover — scan machine for un-migrated .env
# ---------------------------------------------------------------------------
SECRET_NAME_RE = re.compile(
    r"(KEY|SECRET|PASS(WORD)?|TOKEN|CREDENTIALS|DSN|BEARER|WEBHOOK|ENC|AUTH|JWT|CERT|_RSA|PRIVATE|SALT|NONCE)(_|$)",
    re.IGNORECASE,
)

# Value patterns that indicate a secret regardless of name
VALUE_PATTERNS = [
    (re.compile(r"^sk-ant-"),        "Anthropic API key"),
    (re.compile(r"^sk-proj-"),       "OpenAI project key"),
    (re.compile(r"^sk-"),            "OpenAI API key"),
    (re.compile(r"^sk_live_"),       "Stripe live"),
    (re.compile(r"^sk_test_"),       "Stripe test"),
    (re.compile(r"^rk_live_"),       "Stripe restricted live"),
    (re.compile(r"^whsec_"),         "Stripe webhook secret"),
    (re.compile(r"^AKIA"),           "AWS access key ID"),
    (re.compile(r"^ASIA"),           "AWS temp access key"),
    (re.compile(r"^re_"),            "Resend API"),
    (re.compile(r"^xai-"),           "xAI API"),
    (re.compile(r"^gsk_"),           "Groq key"),
    (re.compile(r"^eyJ"),            "JWT signed token"),
    (re.compile(r"^ghp_"),           "GitHub personal token"),
    (re.compile(r"^gho_"),           "GitHub oauth token"),
    (re.compile(r"^-----BEGIN "),    "PEM (certificate/key)"),
]


def _classify(key: str, value: str) -> list[str]:
    """Return a list of reasons this key=value looks like a secret.
    Empty list → probably config."""
    reasons = []
    if SECRET_NAME_RE.search(key):
        reasons.append("name")
    for pat, label in VALUE_PATTERNS:
        if pat.match(value):
            reasons.append(f"pattern:{label}")
            break
    # Entropy proxy: high-entropy long values
    if len(value) >= 32:
        distinct = len(set(value))
        if distinct >= 16:
            reasons.append(f"entropy:{len(value)}ch/{distinct}u")
    return reasons


def _extract_env(path: Path) -> list[tuple[str, str]]:
    """Parse an env-file, return [(key, value), ...]. Skips comments/blanks."""
    out = []
    try:
        for raw in path.read_text().splitlines():
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$", line)
            if not m:
                continue
            key, value = m.group(1), m.group(2)
            # strip surrounding quotes
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            out.append((key, value))
    except (OSError, UnicodeDecodeError):
        pass
    return out


def _find_env_files() -> list[Path]:
    """Find .env-like files across the machine, excluding noise."""
    roots = [Path("/home"), Path("/opt"), Path("/etc"), Path("/root"), Path("/srv")]
    found = set()
    for root in roots:
        if not root.exists():
            continue
        try:
            # Skip well-known noise dirs at any depth
            for p in root.rglob("*"):
                try:
                    if p.is_symlink() or not p.is_file():
                        continue
                except OSError:
                    continue
                name = p.name
                if name.endswith(".swp") or ".bak" in name or ".example" in name:
                    continue
                # Skip operator backup snapshots — already-migrated values, not
                # candidates. Patterns: pre-socialwarden, pre-jwt-*, pre-migration-*,
                # pre-database, pre-test, pre-rotation-*, etc.
                if "pre-socialwarden" in name or ".pre-" in name:
                    continue
                if any(seg in p.parts for seg in (".git", "node_modules", ".venv", "__pycache__")):
                    continue
                # .env, .env.anything, *.env
                if name == ".env" or name.startswith(".env.") or name.endswith(".env"):
                    # Skip GHA runner workspace files (those are ephemeral clones)
                    if "/_work/" in str(p) or "/actions-runner" in str(p):
                        continue
                    # Skip stuff inside /run/secrets (the agent's own output)
                    if str(p).startswith("/run/secrets/"):
                        continue
                    found.add(p.resolve())
        except PermissionError:
            continue
    return sorted(found)


def _vault_keys_from_synced() -> set[str]:
    """Return the set of keys currently synced by the agent (from /run/secrets)."""
    out = set()
    sd = Path(SECRETS_DIR)
    if not sd.is_dir():
        return out
    try:
        for envfile in sd.glob("*.env"):
            try:
                if envfile.name.endswith(".merged"):
                    continue
                for k, _ in _extract_env(envfile):
                    out.add(k)
            except OSError:
                continue
    except PermissionError:
        pass
    return out


def cmd_discover(_args):
    print(f"{BOLD}=== SocialWarden Discovery ==={NC}\n")

    vault_keys = _vault_keys_from_synced()
    print(f"Keys already in vault (via {SECRETS_DIR}): {len(vault_keys)}")

    files = _find_env_files()
    if not files:
        info("No candidate .env files found outside the vault sync.")
        return

    grand_secrets = 0
    grand_config = 0
    for f in files:
        kvs = _extract_env(f)
        if not kvs:
            continue
        secrets = []
        config = []
        for k, v in kvs:
            if k in vault_keys:
                continue  # already migrated
            reasons = _classify(k, v)
            if reasons:
                secrets.append((k, reasons))
            else:
                config.append(k)
        if not secrets and not config:
            continue

        print(f"\n  📄 {f}")
        print(f"     total={len(kvs)}  already-in-vault={sum(1 for k,_ in kvs if k in vault_keys)}")
        if secrets:
            print(f"     {YELLOW}🔒 candidate secrets to migrate ({len(secrets)}):{NC}")
            for k, r in secrets:
                print(f"        {k:<30}  [{', '.join(r)}]")
            grand_secrets += len(secrets)
        if config:
            print(f"     {DIM}📄 config (stays in .env.static, {len(config)}): "
                  f"{', '.join(config[:6])}{'…' if len(config) > 6 else ''}{NC}")
            grand_config += len(config)

    print()
    print(f"{BOLD}Summary:{NC}")
    print(f"  {grand_secrets} secret candidates across {len(files)} files")
    print(f"  {grand_config} config keys (would stay in .env.static)")
    if grand_secrets:
        print()
        print(f"To execute migration (interactive, per-file confirmation):")
        print(f"  {BOLD}sudo socialwarden-agent migrate --apply{NC}")


