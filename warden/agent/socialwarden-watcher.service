# /etc/systemd/system/socialwarden-watcher.service
[Unit]
Description=SocialWarden Watcher — Absorbs stray .env files into the vault
Documentation=https://github.com/your-org/fleet-ops
After=network-online.target socialwarden-agent.service
Wants=network-online.target
# The watcher cooperates with the agent through /var/lib/socialwarden/bw.lock so
# concurrent `bw` operations don't invalidate each other's session. It also
# reads /run/secrets/* (populated by the agent) to detect already-managed
# .env files, so we start AFTER socialwarden-agent.service has bootstrapped.

# Rate-limit restart loops at the [Unit] level (systemd warns if you put
# these in [Service]).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

# /run/secrets and /run/socialwarden-backups live on tmpfs and are wiped on
# every boot. systemd recreates them via RuntimeDirectory= below, but the
# explicit install command guarantees mode 0700 even on older systemd that
# doesn't honour RuntimeDirectoryMode reliably during early start.
ExecStartPre=/usr/bin/install -d -m 700 /run/secrets
ExecStartPre=/usr/bin/install -d -m 700 /run/socialwarden-backups

# Watcher binary. `start` is the daemon loop; the watcher refuses to do work
# unless /etc/socialwarden/watcher-enabled exists — a deliberate opt-in marker
# that prevents accidental absorption sweeps right after package install.
ExecStart=/usr/bin/python3 /opt/socialwarden-watcher/socialwarden-watcher.py --config /etc/socialwarden/config.yaml start

# Ephemeral dirs created/wiped per boot by systemd.
#   RuntimeDirectory=socialwarden          → /run/socialwarden          (mode 0700)
#     hosts watcher-heartbeat and the agent's PID file (read-only ref)
#   RuntimeDirectory=socialwarden-backups  → /run/socialwarden-backups  (mode 0700)
#     30-day rolling backups of absorbed .env files. Tmpfs by design — a
#     reboot purges them, which is the intended worst case (the absorbed
#     value still lives in the vault).
RuntimeDirectory=socialwarden socialwarden-backups
RuntimeDirectoryMode=0700
# Persistent dirs (locks + audit log) — recreated by systemd on each boot
# but their *content* survives.
StateDirectory=socialwarden
StateDirectoryMode=0700
LogsDirectory=socialwarden
LogsDirectoryMode=0700

# --- Security hardening (mirrors socialwarden-agent.service v1.4.x) ----------
NoNewPrivileges=yes

# Most of the filesystem becomes read-only; only paths in ReadWritePaths are
# writable. This catches accidental writes to /etc, /usr, /opt, etc.
ProtectSystem=strict
ProtectHome=no
PrivateTmp=no

# Paths the watcher needs to write to from its own logic:
#   /run/secrets/             — symlink targets the absorbed file points at
#   /run/socialwarden/          — heartbeat file
#   /run/socialwarden-backups/  — 30-day rolling backups
#   /var/lib/socialwarden/      — watcher.lock + bw.lock (shared with agent)
#   /var/log/socialwarden/      — audit jsonl
#
# IMPORTANT: per-host scan paths (watch.paths in /etc/socialwarden/config.yaml)
# are NOT listed here because they vary per machine. install-watcher.sh
# parses watch.paths from the config and writes a drop-in at
#   /etc/systemd/system/socialwarden-watcher.service.d/scan-paths.conf
# with the additional ReadWritePaths=. After editing config.yaml to add a
# new scan root, rerun the installer (or hand-edit + daemon-reload).
ReadWritePaths=/etc/socialwarden /run/secrets /run/socialwarden /run/socialwarden-backups /var/lib/socialwarden /var/log/socialwarden

# Kernel / cgroup / personality lockdowns (baseline agent v1.4.x).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# MemoryDenyWriteExecute=yes deliberately NOT enabled — PyYAML C accelerator
# and the cryptography wheels occasionally need RWX memory for native code.

# --- Restart policy --------------------------------------------------------
Restart=always
RestartSec=10

# --- Logging ---------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socialwarden-watcher

# --- Environment -----------------------------------------------------------
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="HOME=/root"

[Install]
WantedBy=multi-user.target
