# Entry point
# -----------------------------------------------------------------------------
def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="socialwarden-manager",
        description="SocialWarden fleet orchestrator (manager / head).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="manager readiness + paths + tailscale")
    sub.add_parser("list", help="fleet state from inventory.json")

    p_ri = sub.add_parser("register-identity", help="fetch ed25519 pubkey via SSH and register it")
    p_ri.add_argument("machine")
    p_ri.add_argument("--force", action="store_true", help="overwrite an existing different key (dangerous)")

    sub.add_parser("list-identities", help="list all registered peer pubkeys")
    sub.add_parser("distribute-pubkeys", help="push all registered pubkeys to every peer (idempotent)")

    p_rap = sub.add_parser("register-age-pubkey",
        help="fetch a client's age recipient pubkey via SSH and store on manager")
    p_rap.add_argument("machine")
    p_rap.add_argument("--force", action="store_true",
        help="overwrite an existing different pubkey (e.g. after re-key)")

    p_bp = sub.add_parser("bundle-push",
        help="age-encrypt an env-file with a client's pubkey and SCP it to /var/lib/socialwarden/bundles/")
    p_bp.add_argument("machine", help="target machine (must be in inventory)")
    p_bp.add_argument("bundle", help="bundle name (alphanumeric + - _)")
    p_bp.add_argument("--env-file", required=True, help="path to local plaintext env-file")
    p_bp.add_argument("--render", action="store_true",
        help="after upload, run `socialwarden-agent render <bundle>` on the target")

    p_en = sub.add_parser("enroll-shamir",
        help="enroll a machine with K-of-N Shamir-split master (master read from stdin)")
    p_en.add_argument("machine")
    p_en.add_argument("--k", type=int, default=3,
        help="threshold: shares required to reconstruct (default: 3)")
    p_en.add_argument("--n", type=int, default=5,
        help="total shares produced (default: 5; distribution: 1 local + N-2 peers + 1 manager)")
    p_en.add_argument("--peers", default=None,
        help="comma-separated peer names (default: auto-select first N-2 alphabetical eligible)")
    p_en.add_argument("--force", action="store_true",
        help="re-enroll a machine that already has shamir.enabled=true (DESTRUCTIVE: invalidates all old shares)")
    p_en.add_argument("--dry-run", action="store_true",
        help="validate prereqs, enable peer endpoints, but stop BEFORE splitting/distributing shares")

    p_rc = sub.add_parser("recover", help="recover a machine (2 Shamir shares)")
    p_rc.add_argument("machine")

    p_rv = sub.add_parser("revoke",
        help="ROTATE master (NEW) + revoke OLD shares (post-compromise). "
             "NEW master from stdin. Requires --confirm.")
    p_rv.add_argument("machine")
    p_rv.add_argument("--confirm", action="store_true",
        help="confirm this destructive operation (without it, prints plan and exits)")

    p_rs = sub.add_parser("rotate-shares",
        help="rotate Shamir shares (same master, fresh polynomial). Cron-friendly: monthly")
    p_rs.add_argument("--machine", default=None,
        help="rotate only this one machine (default: all shamir-enrolled)")
    p_rs.add_argument("--dry-run", action="store_true",
        help="reconstruct + report what would change, but do not write new shares")

    p_sp = sub.add_parser("shamir-split", help="split a secret from stdin (K-of-N)")
    p_sp.add_argument("--k", type=int, required=True)
    p_sp.add_argument("--n", type=int, required=True)

    p_sc = sub.add_parser("shamir-combine", help="combine shares from stdin → secret")
    p_sc.add_argument("--k", type=int, default=None,
        help="enforce minimum K shares (rejects garbage-output from K-1 interpolation)")

    p_vs = sub.add_parser("verify-shamir",
        help="verify reconstruction works for enrolled machines (cron-friendly)")
    p_vs.add_argument("--machine", default=None,
        help="verify just this one (default: all enrolled)")

    p_bg = sub.add_parser("break-glass-emit",
        help="emit paper-only share x=N+1 for offline storage (master from stdin)")
    p_bg.add_argument("machine")

    p_at = sub.add_parser("audit-tail", help="tail manager audit log")
    p_at.add_argument("-n", type=int, default=40)

    sub.add_parser("help", help="show this help")

    return parser


def main():
    parser = build_parser()
    args = parser.parse_args()

    cmds = {
        "status":            cmd_status,
        "list":              cmd_list,
        "register-identity":  cmd_register_identity,
        "list-identities":     cmd_list_identities,
        "distribute-pubkeys":  cmd_distribute_pubkeys,
        "register-age-pubkey": cmd_register_age_pubkey,
        "bundle-push":         cmd_bundle_push,
        "enroll-shamir":     cmd_enroll_shamir,
        "recover":           cmd_recover,
        "revoke":            cmd_revoke,
        "rotate-shares":     cmd_rotate_shares,
        "verify-shamir":     cmd_verify_shamir,
        "break-glass-emit":  cmd_break_glass_emit,
        "shamir-split":      cmd_shamir_split,
        "shamir-combine":    cmd_shamir_combine,
        "audit-tail":        cmd_audit_tail,
        "help":              lambda _: parser.print_help(),
    }

    cmd = cmds.get(args.command)
    if cmd is None:
        parser.print_help()
        sys.exit(2)

    # Defense-in-depth: any subcommand that takes a `machine` (positional or
    # --machine) must validate before its body runs. A single chokepoint here
    # avoids per-command mistakes.
    validate_machine_name(getattr(args, "machine", None))

    # Atomic transactions: hold the inventory lock across the entire cmd body
    # for any command that may mutate inventory (read-modify-write). Reentrant,
    # so the inner save_inventory call inside cmd_* re-enters cheaply.
    # Read-only or write-elsewhere commands skip the lock to keep them snappy.
    NON_MUTATING = {"status", "list", "list-identities", "audit-tail",
                     "shamir-split", "shamir-combine", "verify-shamir", "help"}
    if args.command in NON_MUTATING:
        cmd(args)
    else:
        with inventory_lock():
            cmd(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
