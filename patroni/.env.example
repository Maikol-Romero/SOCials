# Postgres superuser password — used by the postgres container and by Patroni
POSTGRES_PASSWORD=change-me-strong-password

# Replication user password — used by Patroni replicas to stream from the leader
REPLICATION_PASSWORD=change-me-different-strong-password

# Discord webhook for backup / integrity / switchback notifications.
# Get one from: Server settings → Integrations → Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_ID/REPLACE_WITH_YOUR_WEBHOOK_TOKEN

# S3 bucket for offsite backups + integrity snapshots
# (configure AWS CLI credentials separately via `aws configure` or instance role)
S3_BUCKET=s3://YOUR-BACKUP-BUCKET

# Patroni node name (override per-host if you can't edit patroni.yml directly)
PATRONI_NODE_NAME=node-1
