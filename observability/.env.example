# Bind address — usually the manager host's private/VPN IP
MONITOR_IP=10.20.0.1

# Grafana admin credentials (changed on first login is best practice)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-strong-password
GF_HTTP_PORT=3001
# Public URL Grafana usa para construir links absolutos (e.g., reset password emails)
GF_SERVER_ROOT_URL=http://localhost:3001/

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# Loki
LOKI_PORT=3100
LOKI_RETENTION=168h

# Tempo
TEMPO_HTTP_PORT=3200
TEMPO_GRPC_PORT=4317

# Discord webhooks for alerting (one URL per channel/severity).
# Get these from: Server settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_ID/REPLACE_WITH_YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_SUMMARY=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_ID/REPLACE_WITH_YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_STAGING=https://discord.com/api/webhooks/REPLACE_WITH_YOUR_WEBHOOK_ID/REPLACE_WITH_YOUR_WEBHOOK_TOKEN
