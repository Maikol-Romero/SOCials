# Paths (must match the daemon defaults)
HEARTBEAT_PATH = "/run/socialwarden/heartbeat"
METRICS_PATH = "/tmp/node-exporter-textfile/socialwarden.prom"
VERSIONS_DIR = "/var/lib/socialwarden/versions"
CONFIG_PATH = "/etc/socialwarden/config.yaml"
AUDIT_LOG = "/var/lib/socialwarden/audit.log"
SECRETS_DIR = "/run/secrets"

# Pretty output
RED = "\033[0;31m"; GREEN = "\033[0;32m"; YELLOW = "\033[1;33m"
BLUE = "\033[0;34m"; BOLD = "\033[1m"; DIM = "\033[2m"; NC = "\033[0m"

def info(m):  print(f"{GREEN}[✓]{NC} {m}")
def warn(m):  print(f"{YELLOW}[!]{NC} {m}")
def err(m):   print(f"{RED}[✗]{NC} {m}", file=sys.stderr)
def step(m):  print(f"\n{BLUE}=== {m} ==={NC}")


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def load_config():
    """Read /etc/socialwarden/config.yaml; return dict or None on error."""
    try:
        import yaml
        with open(CONFIG_PATH) as f:
            return yaml.safe_load(f)
    except FileNotFoundError:
        return None
    except PermissionError:
        err(f"Cannot read {CONFIG_PATH} — run with sudo")
        sys.exit(2)
    except Exception as e:
        err(f"Config parse error: {e}")
        return None


def read_metrics():
    """Parse the Prometheus text-format metrics file into a dict."""
    out = {}
    try:
        for line in open(METRICS_PATH):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(" ", 1)
            if len(parts) == 2:
                out[parts[0]] = parts[1]
    except FileNotFoundError:
        pass
    return out


def agent_pid():
    """Return the main PID of the running agent, or None if not running."""
    try:
        r = subprocess.run(
            ["systemctl", "show", "-p", "MainPID", "--value", "socialwarden-agent"],
            capture_output=True, text=True, timeout=5,
        )
        pid = int(r.stdout.strip())
        return pid if pid > 0 else None
    except (subprocess.TimeoutExpired, ValueError, FileNotFoundError):
        return None


def heartbeat_age():
    """Seconds since last heartbeat, or None if no heartbeat file.
    Returns -1 if file exists but we can't read it (PermissionError)."""
    try:
        content = open(HEARTBEAT_PATH).read().strip()
        hb = datetime.fromisoformat(content)
        now = datetime.now(timezone.utc)
        return (now - hb).total_seconds()
    except (FileNotFoundError, ValueError):
        return None
    except PermissionError:
        return -1  # sentinel: exists but unreadable (need sudo)


