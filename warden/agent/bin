def cmd_version(_args):
    # Version is baked into the agent source
    agent_src = "/opt/socialwarden-agent/socialwarden-agent.py"
    if not os.path.exists(agent_src):
        # backward compat: the old package layout
        agent_src = "/opt/socialwarden/socialwarden-agent.py"
    v = "?"
    try:
        for line in open(agent_src):
            m = re.match(r'^VERSION\s*=\s*["\']([^"\']+)', line)
            if m:
                v = m.group(1)
                break
    except FileNotFoundError:
        err(f"Agent not installed at {agent_src}")
        sys.exit(1)
    except PermissionError:
        err(f"Cannot read {agent_src} (run with sudo)")
        sys.exit(2)
    print(f"socialwarden-agent {v}  ({agent_src})")

    # Manager reachability
    cfg = load_config()
    if cfg:
        server_url = cfg.get("server", {}).get("url", "")
