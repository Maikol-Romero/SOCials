def cmd_versions(args):
    vdir = Path(VERSIONS_DIR)
    if not vdir.is_dir():
        err(f"No versions directory at {VERSIONS_DIR}")
        return
    try:
        files = sorted(vdir.glob("*.env"))
    except PermissionError:
        err("Cannot list versions dir (run with sudo)")
        return
    if args.collection:
        files = [f for f in files if f.name.endswith(f"_{args.collection}.env")]
    for f in files:
        print(f.name)


def cmd_rollback(args):
    vfile = Path(VERSIONS_DIR) / f"{args.timestamp}_{args.collection}.env"
    if not vfile.exists():
        err(f"No snapshot at {vfile}")
        sys.exit(1)
    target = f"/run/secrets/{args.collection}.env"
    try:
        data = vfile.read_text()
    except PermissionError:
        err("Cannot read snapshot (run with sudo)")
        sys.exit(2)
    print(f"Would write {len(data)} bytes to {target}")
    print("Rollback currently requires manual confirmation. Run:")
    print(f"  sudo cp {vfile} {target}")
    print(f"  sudo systemctl reload socialwarden-agent  # force re-sync")


# ---------------------------------------------------------------------------
# Subcommand: render  (decrypt age bundle → /run/secrets/<bundle>.env)
# ---------------------------------------------------------------------------
BUNDLES_DIR    = "/var/lib/socialwarden/bundles"
AGE_KEY_PATH   = "/var/lib/socialwarden/age.key"


def _require_root():
    if os.geteuid() != 0:
        err("This command must run as root (sudo socialwarden-agent ...)")
        sys.exit(2)


def _render_one(bundle: str) -> tuple[bool, str]:
    """Decrypt /var/lib/socialwarden/bundles/<bundle>.age into /run/secrets/<bundle>.env.

    Returns (ok, message). The output file is written atomically (tmp+rename)
    with mode 0600 owned by root.
    """
    if not all(c.isalnum() or c in "-_" for c in bundle) or not bundle:
        return False, f"invalid bundle name {bundle!r}"

    src = Path(BUNDLES_DIR) / f"{bundle}.age"
    if not src.exists():
        return False, f"bundle not found: {src}"
    if not Path(AGE_KEY_PATH).exists():
        return False, f"age private key missing: {AGE_KEY_PATH}"

    out_dir = Path(SECRETS_DIR)
    out_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    final = out_dir / f"{bundle}.env"
    tmp = out_dir / f".{bundle}.env.tmp"

    r = subprocess.run(
        ["age", "--decrypt", "-i", AGE_KEY_PATH, "-o", str(tmp), str(src)],
        capture_output=True, text=True, timeout=20,
    )
    if r.returncode != 0:
        try: tmp.unlink()
        except FileNotFoundError: pass
        return False, f"age decrypt failed: {r.stderr.strip()}"

    os.chmod(tmp, 0o600)
    os.chown(tmp, 0, 0)  # root:root
    os.replace(tmp, final)
    return True, f"{final} ({final.stat().st_size} bytes)"


def cmd_render(args):
    _require_root()
    ok, msg = _render_one(args.bundle)
    if ok:
        info(f"Rendered: {msg}")
    else:
        err(msg)
        sys.exit(1)


def cmd_render_all(_args):
    _require_root()
    bdir = Path(BUNDLES_DIR)
    if not bdir.exists():
        warn(f"No bundles dir at {bdir} — nothing to render")
        return
    bundles = sorted(p.stem for p in bdir.glob("*.age"))
    if not bundles:
        warn(f"No bundles in {bdir}")
        return
    failures = 0
    for b in bundles:
        ok, msg = _render_one(b)
        if ok:
            info(f"{b}: {msg}")
        else:
            err(f"{b}: {msg}")
            failures += 1
    if failures:
        sys.exit(1)


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        prog="socialwarden-agent",
        description="SocialWarden agent — client CLI.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status", help="health + metrics + version")
    sub.add_parser("version", help="agent version + manager reachability")
    sub.add_parser("identity", help="show this machine's ed25519 public identity")
    p_pt = sub.add_parser("peer-test", help="test share-release endpoint against a peer (by IP)")
    p_pt.add_argument("peer", help="peer tailscale IP (e.g., 10.20.0.11)")
    sub.add_parser("sync", help="force sync now (SIGHUP)")
    p_logs = sub.add_parser("logs", help="tail journalctl")
    p_logs.add_argument("-n", type=int, default=40)
    sub.add_parser("doctor", help="sanity checks")
    sub.add_parser("discover", help="scan for un-migrated .env files")
    p_migrate = sub.add_parser("migrate", help="migrate discovered secrets to vault")
    p_migrate.add_argument("--apply", action="store_true",
                           help="actually perform the migration (default: dry-run)")
    p_migrate.add_argument("--collection", default=None,
                           help="target Vaultwarden collection ID (required with --apply)")
    p_migrate.add_argument("--organization", default=None,
                           help="Vaultwarden organization ID (defaults to /etc/socialwarden/config.yaml)")
    p_migrate.add_argument("--yes", action="store_true",
                           help="non-interactive: assume yes to per-file confirmations")
    p_audit = sub.add_parser("audit", help="tail UDS API audit log")
    p_audit.add_argument("-n", type=int, default=20)
    p_versions = sub.add_parser("versions", help="list version snapshots")
    p_versions.add_argument("collection", nargs="?")
    p_rollback = sub.add_parser("rollback", help="rollback a collection")
    p_rollback.add_argument("collection")
    p_rollback.add_argument("timestamp")

    p_render = sub.add_parser("render",
        help="decrypt /var/lib/socialwarden/bundles/<bundle>.age into /run/secrets/<bundle>.env")
    p_render.add_argument("bundle")
    sub.add_parser("render-all",
        help="render every *.age bundle present in /var/lib/socialwarden/bundles/")

    sub.add_parser("help", help="show this help")

    args = parser.parse_args()

    cmds = {
        "status":   cmd_status,
        "version":  cmd_version,
        "identity": cmd_identity,
        "peer-test": cmd_peer_test,
        "sync":     cmd_sync,
        "logs":     cmd_logs,
        "doctor":   cmd_doctor,
        "discover": cmd_discover,
        "migrate":  cmd_migrate,
        "audit":    cmd_audit,
        "versions":   cmd_versions,
        "rollback":   cmd_rollback,
        "render":     cmd_render,
        "render-all": cmd_render_all,
        "help":       lambda _: parser.print_help(),
    }

    cmd = cmds.get(args.command)
    if cmd is None:
        parser.print_help()
        sys.exit(2)
    cmd(args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
