# SOCials — Central Configuration
# Copy to socials.yml and edit, then run: socials env-gen
#
# Environment variables SOCIALS_<SECTION>_<KEY> override any value here.
# Example: SOCIALS_MONITOR_IP=10.0.0.5 overrides monitor.ip

# ─── Monitor host ──────────────────────────────────────────────
monitor:
  ip: 10.20.0.1          # Tailscale/VPN IP of the monitor machine
  name: socials-monitor   # Inventory name for this host

# ─── Grafana ───────────────────────────────────────────────────
grafana:
  user: admin
  password: change-me-strong-password    # Changed on first login
  port: 3001
  root_url: http://localhost:3001/

# ─── Prometheus ────────────────────────────────────────────────
prometheus:
  port: 9090
  retention: 15d

# ─── Loki (logs) ───────────────────────────────────────────────
loki:
  port: 3100
  retention: 168h          # 7 days

# ─── Tempo (traces) ───────────────────────────────────────────
tempo:
  http_port: 3200
  grpc_port: 4317

# ─── AdGuard DNS ───────────────────────────────────────────────
dns:
  port: 53
  web_port: 2999

# ─── Homepage dashboard ───────────────────────────────────────
homepage:
  port: 8082
  allowed_hosts: homepage.example.com,10.20.0.1:8082

# ─── Wazuh SIEM ───────────────────────────────────────────────
wazuh:
  indexer_password: ""     # Generated by setup.sh if left empty
  indexer_java_opts: "-Xms512m -Xmx512m"
  api_user: wazuh-wui
  api_password: ""         # Generated by setup.sh if left empty
  dashboard_password: ""
  dashboard_port: 5601

# ─── Patroni HA Postgres ──────────────────────────────────────
patroni:
  postgres_password: ""    # Required — set a strong password
  replication_password: ""
  node_name: node-1
  s3_bucket: ""            # s3://your-backup-bucket

# ─── Trivy scanner ────────────────────────────────────────────
trivy:
  discord_webhook: ""      # Optional — weekly scan alerts

# ─── Discord webhooks ─────────────────────────────────────────
discord:
  webhook_url: ""          # Main alerts channel
  webhook_summary: ""      # Daily summary channel
  webhook_staging: ""      # Staging alerts channel

# ─── BetterStack bridge ───────────────────────────────────────
betterstack:
  token: ""
  status_page_id: ""
  inbound_token: ""        # Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
  resources:               # Map service keys to BetterStack resource IDs
    api: ""
    web: ""
    worker: ""
    database: ""
    queue: ""

# ─── Agent exporter ports ─────────────────────────────────────
agent_exporters:
  node_exporter_port: 9100
  cadvisor_port: 8080
  pg_exporter_port: 9187
  redis_exporter_port: 9121
  otel_metrics_port: 8889
  gpu_exporter_port: 9400
