#!/usr/bin/env python3
"""socialwarden-agent — client CLI for the SocialWarden secrets agent.

One tool for the operator on a single machine. Wraps systemd signals and
inspects local state (heartbeat, metrics, audit log, /run/secrets).

Usage:
  socialwarden-agent status                  — health + metrics + version
  socialwarden-agent version                 — just the version + manager reachable
  socialwarden-agent sync                    — force sync now (sends SIGHUP)
  socialwarden-agent logs [-n N]             — tail journalctl for the agent
  socialwarden-agent doctor                  — sanity checks (config, paths,
                                             permissions, vault reachable)
  socialwarden-agent discover                — scan this machine for un-migrated
                                             .env files (read-only)
  socialwarden-agent migrate [--apply]       — propose and (with --apply) execute
                                             migration of disk-only secrets to
                                             vault + merge+symlink activation
  socialwarden-agent audit [-n N]            — tail the UDS API audit log
  socialwarden-agent versions <collection>   — list saved version snapshots
  socialwarden-agent rollback <coll> <ts>    — rollback a collection to ts
  socialwarden-agent help                    — this message
"""

