# Bind address — usually the manager host's private/VPN IP
MONITOR_IP=10.20.0.1

# Comma-separated host:port pairs that Homepage will accept requests for
HOMEPAGE_ALLOWED_HOSTS=homepage.example.com,10.20.0.1:8082
HOMEPAGE_PORT=8082

# Grafana admin password (must match the one configured in your Grafana stack —
# Homepage queries Grafana's API to render the metrics widget)
GF_ADMIN_PASSWORD=change-me-strong-password
GF_HTTP_PORT=3001

# Other backend ports — only change if your stacks use non-default ports
PROMETHEUS_PORT=9090
DNS_WEB_PORT=2999
WAZUH_DASHBOARD_PORT=5601
