# Bind address — usually the manager host's private/VPN IP
MONITOR_IP=10.20.0.1

# OpenSearch indexer admin password (8+ chars, mixed case + symbols)
INDEXER_PASSWORD=change-me-strong-password

# Indexer JVM heap (match to host RAM: ~half of physical, max 32g)
INDEXER_JAVA_OPTS=-Xms1g -Xmx1g

# Wazuh API user used by manager + dashboard
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=change-me-different-strong-password

# Dashboard internal kibanaserver password
DASHBOARD_PASSWORD=change-me-yet-another-strong-password
