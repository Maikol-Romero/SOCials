def cmd_audit(args):
    n = args.n or 20
    try:
        lines = open(AUDIT_LOG).readlines()
    except FileNotFoundError:
        err(f"No audit log at {AUDIT_LOG} (UDS API may be disabled)")
        sys.exit(1)
    except PermissionError:
        err(f"Audit log not readable (run with sudo)")
        sys.exit(2)
    for line in lines[-n:]:
        try:
            entry = json.loads(line)
            ts = entry.get("ts", "")[:19]
            c = entry.get("container", "?")
            s = entry.get("secret", "?")
            d = entry.get("decision", "?")
            color = GREEN if d == "ok" else (YELLOW if d == "rate_limited" else RED)
            print(f"{ts}  {color}{d:<12}{NC}  {c:<30}  {s}")
        except json.JSONDecodeError:
            continue


