# VPN address of THIS host (Tailscale IP, WireGuard IP, etc.) — set automatically by install.sh
TAILSCALE_IP=100.64.0.10

# VPN address of the monitor host (Prometheus / Loki / Tempo / Wazuh manager)
MONITOR_IP=100.64.0.1

# Exporter ports (defaults match the docker-compose.yml)
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
PG_EXPORTER_PORT=9187
REDIS_EXPORTER_PORT=9121
OTEL_METRICS_PORT=8889
GPU_EXPORTER_PORT=9400

# Local Redis (optional — only if redis-exporter should run)
REDIS_HOST=redis
REDIS_PORT=6379

# Local PostgreSQL (optional — only if postgres-exporter should run)
DB_USER=monitor
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
