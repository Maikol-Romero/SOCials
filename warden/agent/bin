def cmd_status(_args):
    print(f"{BOLD}=== SocialWarden Agent Status ==={NC}\n")

    pid = agent_pid()
    if pid:
        print(f"Service: {GREEN}active{NC} (PID {pid})")
    else:
        print(f"Service: {RED}inactive{NC}")

    age = heartbeat_age()
    if age is None:
        print(f"Heartbeat: {RED}missing{NC}")
    elif age == -1:
        print(f"Heartbeat: {YELLOW}unreadable{NC} (run with sudo for details)")
    elif age < 120:
        print(f"Heartbeat: {GREEN}healthy{NC} ({age:.0f}s ago)")
    elif age < 600:
        print(f"Heartbeat: {YELLOW}stale{NC} ({age:.0f}s ago)")
    else:
        print(f"Heartbeat: {RED}stalled{NC} ({age:.0f}s ago)")

    metrics = read_metrics()
    if metrics:
        print("\nMetrics:")
        for k in (
            "socialwarden_sync_total",
            "socialwarden_sync_errors_total",
            "socialwarden_secrets_count",
            "socialwarden_changes_detected_total",
            "socialwarden_drift_detected_total",
            "socialwarden_last_sync_timestamp",
        ):
            if k in metrics:
                print(f"  {k:<42} = {metrics[k]}")

    # Secrets files + sizes
    sd = Path(SECRETS_DIR)
    if sd.is_dir():
        try:
            files = sorted(sd.glob("*.env"))
            if files:
                print(f"\nSynced files in {SECRETS_DIR}:")
                for f in files:
                    try:
                        st = f.stat()
                        age_f = (time.time() - st.st_mtime)
                        print(f"  {f.name:<24} {st.st_size:>6}B  updated {age_f:.0f}s ago")
                    except OSError:
                        continue
        except PermissionError:
            warn("Cannot list /run/secrets — run with sudo for full view")

    print()


