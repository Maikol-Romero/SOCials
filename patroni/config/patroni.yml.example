# Patroni node config — copy to config/patroni.yml on each node and
# adjust per-node fields: name, restapi.connect_address, postgresql.connect_address.
#
# scope identifies the cluster (must be identical across all nodes).
# name identifies this specific node (must be unique within the scope).

scope: postgres-cluster
name: node-1                         # CHANGE: node-2, node-3, ... per host

restapi:
  listen: 0.0.0.0:8008
  connect_address: 10.20.0.10:8008   # CHANGE: this node's reachable IP

# Distributed Configuration Store. etcd is the simplest; Consul / Zookeeper
# are also supported. Point at the DCS reachable from every node.
etcd3:
  host: 10.20.0.1:2379               # CHANGE: your etcd endpoint

bootstrap:
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: false
      use_slots: true
      parameters:
        wal_level: logical
        max_wal_senders: 10
        max_replication_slots: 5
        hot_standby: 'on'
        shared_buffers: 2GB
        effective_cache_size: 6GB
        work_mem: 64MB
        maintenance_work_mem: 512MB
        max_connections: 200
        archive_mode: 'on'
        archive_command: '/bin/true'
        # Supabase-flavored extension list. Trim if you're using vanilla Postgres.
        shared_preload_libraries: 'pg_stat_statements, pgaudit, plpgsql, plpgsql_check, pg_cron, pg_net, pgsodium, timescaledb, auto_explain, pg_tle, plan_filter, supabase_vault'

  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 0.0.0.0:5432
  connect_address: 10.20.0.10:5432   # CHANGE: this node's reachable IP
  data_dir: /var/lib/postgresql/data
  config_dir: /var/lib/postgresql/data
  custom_conf: /etc/postgresql/postgresql.conf
  bin_dir: /nix/var/nix/profiles/default/bin
  pgpass: /tmp/pgpass
  authentication:
    superuser:
      username: postgres
      password: ${POSTGRES_PASSWORD}            # injected from .env
    replication:
      username: replicator
      password: ${REPLICATION_PASSWORD}         # injected from .env
  parameters:
    unix_socket_directories: '/var/run/postgresql'
    shared_preload_libraries: 'pg_stat_statements, pgaudit, plpgsql, plpgsql_check, pg_cron, pg_net, pgsodium, timescaledb, auto_explain, pg_tle, plan_filter, supabase_vault'
  pg_hba:
    - local all all trust
    - local replication all trust
    - host replication replicator 127.0.0.1/32 trust
    - host all all 127.0.0.1/32 trust
    - host all all ::1/128 trust
    # Adjust the next two lines to your private network CIDR.
    - host replication replicator 10.0.0.0/8 trust
    - host all all 10.0.0.0/8 trust
    # External connections require SCRAM-SHA-256 auth.
    - host all all 0.0.0.0/0 scram-sha-256
    - host all all ::0/0 scram-sha-256

tags:
  nofailover: false
  failover_priority: 3              # higher value → preferred leader on switchover
  noloadbalance: false
  clonefrom: false
  nosync: false
