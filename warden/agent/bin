def cmd_sync(_args):
    pid = agent_pid()
    if not pid:
        err("Agent not running. Start it with: sudo systemctl start socialwarden-agent")
        sys.exit(1)
    try:
        os.kill(pid, 1)  # SIGHUP triggers a force-sync in the daemon
        info(f"Sent SIGHUP to PID {pid} — sync scheduled on next wakeup")
    except ProcessLookupError:
        err(f"PID {pid} disappeared")
        sys.exit(1)
    except PermissionError:
        err("Permission denied — run with sudo")
        sys.exit(2)


