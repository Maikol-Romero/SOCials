# Audit rules — filesystem tripwire for secret paths
#
# Pattern: any read or write of files under the protected directories that
# was NOT done by a logged-in user session is suspicious by default.
# Long-running daemons (the secrets agent itself, dockerd, container
# processes, the Wazuh syscheckd) run with auid=unset (4294967295) — they
# never satisfy `auid!=4294967295`, so they generate zero events.
# Only an operator who SSH'd in and ran `sudo cat /run/secrets/X` or
# `sudo cat /proc/<pid>/root/run/secrets/X` will trigger these rules.
#
# Adjust the paths to your fleet:
#   Set A — runtime secret outputs (tmpfs)
#   Set B — long-lived key material (master.key, identity.key, snapshots)
#
# Append `-a always,exit ...` lines below to /etc/audit/rules.d/ and run
#   sudo augenrules --load
# to load. Verify with `auditctl -l`.

# ---- Set A: runtime secret outputs (read-only triggers) ----
-a always,exit -F dir=/run/secrets -F perm=r -F auid!=4294967295 -k secrets_read

# ---- Set B: long-lived key material (read + write triggers) ----
-a always,exit -F path=/var/lib/socialwarden/master.key   -F perm=rwa -F auid!=4294967295 -k keymat
-a always,exit -F path=/var/lib/socialwarden/identity.key -F perm=rwa -F auid!=4294967295 -k keymat
-a always,exit -F dir=/var/lib/socialwarden/versions      -F perm=rwa -F auid!=4294967295 -k keymat

# Never leave these rules unbounded — auditd has a finite backlog buffer.
# Tune /etc/audit/auditd.conf: max_log_file=100 (MB), num_logs=5,
# space_left_action=SYSLOG, admin_space_left_action=SUSPEND.
