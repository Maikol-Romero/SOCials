def _bw_create_login(session: str, name: str, value: str, collection_id: str | None,
                      organization_id: str | None) -> tuple[bool, str]:
    """Create a Vaultwarden Secure Note item via bw CLI. Returns (ok, msg)."""
    item = {
        "type": 2,  # 2 = secureNote
        "name": name,
        "secureNote": {"type": 0},
        "notes": value,
        "fields": [{"name": name, "value": value, "type": 1}],  # type 1 = hidden
        "collectionIds": [collection_id] if collection_id else [],
        "organizationId": organization_id,
    }
    encoded = subprocess.run(
        ["bw", "encode"], input=json.dumps(item), capture_output=True, text=True, timeout=10,
    )
    if encoded.returncode != 0:
        return False, f"bw encode failed: {encoded.stderr.strip()[:120]}"
    create = subprocess.run(
        ["bw", "create", "item", encoded.stdout.strip()],
        capture_output=True, text=True, timeout=15,
        env={**os.environ, "BW_SESSION": session},
    )
    if create.returncode != 0:
        return False, f"bw create failed: {create.stderr.strip()[:120]}"
    try:
        created = json.loads(create.stdout)
        return True, f"id={created.get('id', '?')}"
    except json.JSONDecodeError:
        return False, f"bw returned non-JSON: {create.stdout[:80]}"


def cmd_migrate(args):
    """Migrate disk-only secrets to Vaultwarden.

    Flow:
      1. Reuse cmd_discover logic to find candidate .env files + classified secrets.
      2. For each candidate: prompt confirmation (unless --yes).
      3. Create a Secure Note item in Vaultwarden via bw CLI (requires BW_SESSION).
      4. Backup the original .env to .env.pre-socialwarden-<STAMP> (NEVER overwrite an existing backup).
      5. Print summary + manual next-steps for operator (compose env_file change is intentionally manual).

    Safety:
      - Without --apply, shows discover output (dry-run, no side effects).
      - Per-file confirmation by default; --yes for non-interactive.
      - Backups always created before any state-touching action; never overwritten.
      - bw session via BW_SESSION env var ONLY (never reads agent's master.key).
    """
    if not args.apply:
        print(f"{BOLD}=== SocialWarden Migrate (DRY-RUN) ==={NC}\n")
        print("This is a dry-run. Shows what would be migrated.")
        print(f"To actually migrate, add {BOLD}--apply{NC}.\n")
        cmd_discover(None)
        return

    # ---- prereqs ----
    session = os.environ.get("BW_SESSION", "").strip()
    if not session:
        err("BW_SESSION not set. Run first:")
        err(f"  {BOLD}export BW_SESSION=$(bw unlock --raw){NC}")
        err("  ...then re-run with --apply.")
        sys.exit(2)
    if not args.collection:
        err(f"--collection <ID> required (target Vaultwarden collection ID).")
        err(f"List yours: {BOLD}bw list collections{NC}")
        sys.exit(2)

    org_id = args.organization
    if not org_id:
        # Fall back to the org id in /etc/socialwarden/config.yaml
        try:
            import yaml as _yaml
            with open(CONFIG_PATH) as f:
                cfg = _yaml.safe_load(f) or {}
            org_id = (cfg.get("organization") or {}).get("id")
        except Exception:
            org_id = None

    # Validate session is alive
    status = subprocess.run(["bw", "status"], capture_output=True, text=True, timeout=10,
                            env={**os.environ, "BW_SESSION": session})
    if status.returncode != 0 or '"unlocked"' not in status.stdout:
        err(f"bw session not unlocked. Re-run: export BW_SESSION=$(bw unlock --raw)")
        sys.exit(2)
    info("bw session OK (unlocked)")

    # ---- find candidates (mirror cmd_discover) ----
    env_files = _find_env_files()
    synced_keys = _vault_keys_from_synced()
    candidates: list[tuple[Path, list[tuple[str, str, list[str]]]]] = []
    for env_path in env_files:
        kv = _extract_env(env_path)
        secrets = []
        for k, v in kv:
            if k in synced_keys:
                continue
            tags = _classify(k, v)
            if "secret" in tags or "high-entropy" in tags:
                secrets.append((k, v, tags))
        if secrets:
            candidates.append((env_path, secrets))

    if not candidates:
        info("Nothing to migrate. Discover finds no un-migrated secret candidates.")
        return

    # ---- per-file confirmation + actual migration ----
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    summary: list[tuple[str, str, str]] = []  # (file, key, status)

    for env_path, secrets in candidates:
        print(f"\n{BOLD}=== {env_path} ({len(secrets)} candidate(s)) ==={NC}")
        for k, v, tags in secrets:
            print(f"  {k:<30} (len={len(v)}, tags={','.join(tags)})")
        if not args.yes:
            try:
                ans = input(f"  Migrate ALL {len(secrets)} from this file? [y/N] ").strip().lower()
            except EOFError:
                ans = ""
            if ans != "y":
                for k, _, _ in secrets:
                    summary.append((env_path.name, k, "skipped"))
                continue

        # Backup the env file (atomic, never overwrite existing)
        backup = env_path.with_suffix(env_path.suffix + f".pre-socialwarden-{stamp}")
        if backup.exists():
            warn(f"Backup {backup} already exists — skipping migration of this file.")
            for k, _, _ in secrets:
                summary.append((env_path.name, k, "skipped: backup exists"))
            continue
        try:
            backup.write_bytes(env_path.read_bytes())
            os.chmod(backup, 0o600)
            info(f"  Backup: {backup}")
        except OSError as e:
            err(f"  Backup failed for {env_path}: {e}")
            for k, _, _ in secrets:
                summary.append((env_path.name, k, f"backup-fail: {e}"))
            continue

        # Create vault items
        for k, v, _ in secrets:
            ok, msg = _bw_create_login(session, k, v, args.collection, org_id)
            if ok:
                info(f"    {k}: created ({msg})")
                summary.append((env_path.name, k, "ok"))
            else:
                err(f"    {k}: FAIL — {msg}")
                summary.append((env_path.name, k, f"fail: {msg}"))

    # ---- summary ----
    ok_count = sum(1 for _, _, s in summary if s == "ok")
    fail_count = sum(1 for _, _, s in summary if s.startswith("fail"))
    skip_count = sum(1 for _, _, s in summary if s.startswith("skip"))

    print(f"\n{BOLD}=== Migration Summary ==={NC}")
    print(f"  ok:      {ok_count}")
    print(f"  failed:  {fail_count}")
    print(f"  skipped: {skip_count}")
    print()
    print(f"  {DIM}detail:{NC}")
    for f, k, s in summary:
        color = GREEN if s == "ok" else (YELLOW if s.startswith("skip") else RED)
        print(f"    {f:<30} {k:<30} {color}{s}{NC}")

    print(f"\n{BOLD}NEXT STEPS (manual):{NC}")
    print(f"  1. {BOLD}bw sync{NC}                                          # refresh CLI cache")
    print(f"  2. Edit /etc/socialwarden/config.yaml to subscribe this machine")
    print(f"     to the collection containing the new items.")
    print(f"  3. {BOLD}sudo systemctl restart socialwarden-agent{NC}           # pull from vault")
    print(f"  4. Update your compose.yaml env_file to point at /run/secrets/<col>.env")
    print(f"  5. {BOLD}docker compose up -d{NC}                              # apps pick up new secrets")
    print(f"  6. After validation, remove the old .env (keep .pre-socialwarden-{stamp} backup)")

    sys.exit(0 if fail_count == 0 else 4)


